# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/securevault

# Authentication Secret
JWT_SECRET=securevault_jwt_super_secret_production_ready_key_987654321
JWT_EXPIRES_IN=7d

# Cryptographic Master Encryption Key (32 bytes = 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_master_encryption_key_here

# Gmail SMTP Configuration for OTP Verification
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to Google Account Security -> App Passwords -> Generate App Password for 'Mail'
# 3. Enter the 16-character App Password below (without spaces)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
